---
layout: null
---
{% assign notes = site.posts | where_exp: 'post', 'post.hidden != true' %}
[{% for post in notes %}{"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"description":{{ post.description | default: '' | jsonify }},"body":{{ post.content | markdownify | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
